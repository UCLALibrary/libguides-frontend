"s-lg-gtitle\">\n                            <a class=\"bold\" href=\"/libguides-frontend/pr-21/patents/\">Patents and Patent Searching</a> <i class=\"fa fa-info-circle s-lib-popover pad-left-sm\" rel=\"popover\" data-id=\"180322\" data-toggle=\"popover\" data-ajload=\"/index_process.php?action=175&amp;guide_id=180322&amp;group_id=0\" title=\"Patents and Patent Searching&nbsp;\"></i>\n                        </div>\n                    </div>\n                </div>\n            </div>","databases":"<div class=\"pull-left\"><h2 class=\"muted\">Showing 14 Databases</h2></div><div style=\"clear:both;\"><div id=\"s-lg-db-name-featured\" class=\"s-lg-db-panel\" style=\"margin-bottom:30px;\"><div class=\"s-lg-db-panel-title\" style=\"border-bottom:none;\">Best Bets!</div><div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"https://guides.library.ucla.edu/free-resources/home\" target=\"_blank\"><img loading=\"lazy\" alt=\"Open Access\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/33899/32px-Lock-orange-alt-4.svg.png\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://search.ebscohost.com/login.aspx?authtype=ip,uid&amp;profile=ehost&amp;defaultdb=ddu\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '21275363',_st_inc_return: this});\">\n                                                                American Doctoral Dissertations 1933-1955\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p>Freely available database that provides access to the only comprehensive index of dissertations accepted by American universities between 1933 and 1955.</p></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://www.atozdatabases.com/search\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '5617467',_st_inc_return: this});\">\n                                                                AtoZdatabases: Target Company Lists\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Creates custom lists from more than 30 million US business profiles filtered by geography, industry, SIC and or NAICS codes, public/private ownership, employee size, annual revenue, and more. Then export search results to Excel. The database also includes more than 2.3 million job listings, 1.1. million healthcare professionals, 2 million new businesses, and much more.<p></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://www.best-in-class.com/bestp/domrep.nsf/memberwelcomepage?Open&amp;Login\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '49189675',_st_inc_return: this});\">\n                                                                Best Practices Database\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p>Provides benchmarking data and other strategic research, originally commissioned by Fortune 500 clients and the like, on real life \"best practices\" in such areas as customer service, sales and marketing, human resources, operations, knowledge management, the Internet, and e-business.</p></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://guides.library.ucla.edu/BizMiner\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '49189944',_st_inc_return: this});\">\n                                                                Bizminer\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Provides detailed financial and marketing data for some 16,000 lines of business in 300 national and local markets throughout the United States Find industry financials and ratios by keyword, industry group, or by industry classification code number (SIC or NAICS), or use keywords to drill down to an industry or segment..</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"http://www.researchsource.amdigital.co.uk/BusEconLab\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '53908351',_st_inc_return: this});\">\n                                                                Business, Economic and Labour History\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Historical sources from Britain and America, covering key subjects such as Keynesian economic policy in post-war Britain; international labour movements; the London Stock Exchange; and the papers of important economists. Includes a complete run of the <i>Stock Exchange Official Year-book</i> for 1875-1945 and working papers of John Maynard Keynes and his private office during his second period of service at the Treasury.</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://academic.oup.com/oxford-research-encyclopedias?login=true\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '68918617',_st_inc_return: this});\">\n                                                                Oxford Research Encyclopedias\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p><strong>Oxford Research Encyclopedias</strong> is a series of digital works that present peer-reviewed articles on a wide range of topics, such as Anthropology, Business and Management, Climate Science, Communication, Criminology, Economics, Education, Global Public Health, History, Linguistics, Literature, Planetary Science, Politics, Psychology and Religion.</p></div>\n                    </div>\n    </div>\n</div>\n</div><div id=\"s-lg-sb-name-regular\" class=\"s-lg-db-panel\"><div class=\"s-lg-db-panel-title\" style=\"border-bottom:none;\">Additional Databases</div><div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://guides.library.ucla.edu/BCCResearch\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '49189396',_st_inc_return: this});\">\n                                                                BCC Research\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Provides full-text market research reports covering major economic, scientific, and technological developments in industrial and advanced manufacturing (Business-to-Business), biotechnology, pharmaceutical, energy, environmental, and high technology organizations. <b>Current subscription includes all 26 available report categories.</b></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://guides.library.ucla.edu/IBISWorld\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '5617895',_st_inc_return: this});\">\n                                                                IBISWorld Industry Research Reports\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p>Industry market research and risk ratings. UCLA subscription includes the US Industry Reports (NAICS); US Business Environment Profiles; US Industry iExpert Summaries; and US Specialized Industry Reports.<br>&nbsp;</p><p><strong><u>Newly Added Content (May 2023</u>): US Business Environment State Profiles; US Industry State Reports; US Spotlight Industry Reports; US State Economic Profiles.</strong></p></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://guides.library.ucla.edu/marketresearch\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '5618122',_st_inc_return: this});\">\n                                                                MarketResearch.com Academic\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p>Searchable repository (aggregator) of over 3,000 full-text market research reports covering eight major subject areas: business services, consumer goods, demographics, food &amp; beverage, heavy industry, life sciences, public sector, and technology and media. <strong>The following market research firms are the contributors included in UCLA's subscription: Freedonia Focus; Kalorama Information; Mind Commerce; Packaged Facts; and Simba Information.</strong> To get to Freedonia Focus Reports, go to Advanced Search and click on the drop-down menu of Publishers.</p></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://guides.library.ucla.edu/MergentSupplyChain\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '49190147',_st_inc_return: this});\">\n                                                                Mergent Supply Chain\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p>Provides comprehensive coverage of companies--their products, major customers, suppliers, partners, and industries. Covers all companies traded on the NYSE, AMEX and NASDAQ. Includes enhanced detail for companies in six major sectors: Business and Public Services; Conglomerates; Consumer; Energy; Finance; Healthcare; Industrial and Materials; and Technology. Originally known as <strong>Horizon</strong>. Accessible directly and also as a tab within <a href=\"https://marketatlas.mergent.com/\" target=\"_blank\">Mergent Market Atlas</a>.</p></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://guides.library.ucla.edu/Orbis\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '5618235',_st_inc_return: this});\">\n                                                                Orbis\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Orbis contains comprehensive information on public and private companies worldwide, with especially strong coverage of private companies (depending on the country in which the company is located).</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://guides.library.ucla.edu/ProcurementIQ\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '51929519',_st_inc_return: this});\">\n                                                                Procurement IQ\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Reports covering more than 1000 U.S. industries which provide a highly granular overview of the procurement process, to faciilitate supply chain planning and purchasing decisions. Reports provide analysis and data related to product or service pricing dynamics, product characteristics that influence purchasing decisions, supplier benchmarking and supply chain risks, and negotiation questions and strategies. Procurement IQ is a division of IBISWorld, the producer of U.S. and international industry reports which are also available at UCLA.</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://guides.library.ucla.edu/sportsmarketanalytics\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '8063299',_st_inc_return: this});\">\n                                                                SMA: Sports Market Analytics\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Focuses on the sporting goods and sports marketing industry; data includes consumer demographics, sports participation rates, online consumer buying patterns, sports attendance statistics, and international market surveys. Searchable, full text access to many sports business trade journals is also provided. (Also  known as SBRNet: Sports Business Research Network.)</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://guides.library.ucla.edu/Zephyr\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '5618730',_st_inc_return: this});\">\n                                                                Zephyr\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p>Comprehensive database of future, rumored, current, and historical corporate \"deals:\" mergers &amp; acquisitions, initial public offerings, joint ventures, and private equity/venture capital deals. No minimum deal value. Over 100 available search criteria, including company name, industry, date, deal structure, deal type, deal status, etc. European deal coverage begins with 1997, North America with 2000, and global coverage with 2003. Updated daily.</p></div>\n                    </div>\n    </div>\n</div>\n</div></div>","experts":"<div class=\"margin-bottom-xlg\"><div class=\"s-lib-public-side-header\"><h2 class=\"pad-bottom-sm\">Management, Business & Labor Studies Experts</h2></div><div class=\"txt pad-top-sm\"><div class=\"s-lib-featured-profile-spacer clearfix\"></div><div class=\"s-lib-featured-profile-container\"><a href=\"https://guides.library.ucla.edu/prf.php?id=0a9064d7-5704-11ee-8db8-127d3674933b\"><div class=\"s-lib-featured-profile-image\"><img loading=\"lazy\" src=\"//d2jv02qf7xgjwx.cloudfront.net/apps/common/images/profile.jpg\" alt=\"\" /></div><div class=\"s-lib-profile-div s-lib-featured-profile-name\">Ming Liu</div></a></div><div class=\"s-lib-featured-profile-container\"><a href=\"https://guides.library.ucla.edu/prf.php?id=58e5a31d-7cdb-11ed-9922-0ad758b798c3\"><div class=\"s-lib-featured-profile-image\"><img loading=\"lazy\" src=\"//d2jv02qf7xgjwx.cloudfront.net/accounts/32595/profiles/27014/akh_newish.jpg\" alt=\"\" /></div><div class=\"s-lib-profile-div s-lib-featured-profile-name\">Angela Horne</div></a></div><div class=\"s-lib-featured-profile-spacer clearfix\"></div><div class=\"s-lib-featured-profile-container\"><a href=\"https://guides.library.ucla.edu/prf.php?id=58d2241e-7cdb-11ed-9922-0ad758b798c3\"><div class=\"s-lib-featured-profile-image\"><img loading=\"lazy\" src=\"//d2jv02qf7xgjwx.cloudfront.net/accounts/2951/profiles/18410/PAFF2012-MG-KAJ.jpg\" alt=\"Miki Goral and Kareem Abdul Jabbar\" /></div><div class=\"s-lib-profile-div s-lib-featured-profile-name\">Miki Goral</div></a></div></div></div>","blog_posts":"<div class=\"pull-left\"><h2 class=\"muted\">No blog posts have been assigned to this subject.</h2></div>","er_courses":"","rows":1},"version":"x.x"}