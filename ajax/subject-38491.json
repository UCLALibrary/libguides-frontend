jwx.cloudfront.net/sites/705/icons/33899/32px-Lock-orange-alt-4.svg.png\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://search.ebscohost.com/login.aspx?authtype=ip,uid&amp;profile=ehost&amp;defaultdb=ddu\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '21275363',_st_inc_return: this});\">\n                                                                American Doctoral Dissertations 1933-1955\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p>Freely available database that provides access to the only comprehensive index of dissertations accepted by American universities between 1933 and 1955.</p></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://go.galegroup.com/gdsc/i.do?id=3XNY&amp;v=2.1&amp;u=uclosangeles&amp;it=aboutCollections&amp;p=GDSC&amp;sw=w\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '42402619',_st_inc_return: this});\">\n                                                                American Indian Correspondence: Presbyterian Historical Society Collection of Missionaries’ Letters, 1833-1893 (Archives Unbound)\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">The collection consists primarily of the correspondence of missionaries written to the secretaries of the ABCFM and the Presbyterian BFM. Documenting the mission work among Native Americans, letters are presumably official in nature but often contain much personal comment and experiences. Also the collection consists of reports, including school and mission station reports and statistics; financial statements, accounts, and vouchers; agreements/contracts; maps; and other assorted material.</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://apps.brepolis.net/brebiaph/\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '5617411',_st_inc_return: this});\">\n                                                                Annee Philologique\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p>An international critical and analytical bibliography of ancient Greek and Latin languages and literatures and all aspects of classical studies. Citations and abstracts for books, journal articles, festschriften, and other collections from the mid 1950s onwards, except for the most recent three or four years. Also known as Database of Classical Bibliography.<span style=\"display:none;\">L'Année philologique</span></p></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://primarysources.brillonline.com/browse/archives-of-the-church-of-uganda\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '48499984',_st_inc_return: this});\">\n                                                                Archives of the Church of Uganda Online\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Period from the arrival of the first Church Missionary Society missionaries at King Mutesa's court (1877) to the early 1980s. Contents of the collection include legal and administrative documents, correspondence, publications, personal records and more from the Offices of the Archbishops and Bishops of Uganda, the Education Secretary General, the General, Financial, and Provincial Secretaries, the Provincial Treasurer, and the Mother’s Union.</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://primarysources.brillonline.com/browse/archives-of-the-presbyterian-church-of-cuba-online\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '48500008',_st_inc_return: this});\">\n                                                                Archives of the Presbyterian Church of Cuba Online\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">The records of the Iglesia Presbiteriana-Reformada en Cuba (IPRC) and predecessor Presbyterian churches and missions in Cuba, including a complete run of Heraldo Cristiano, the church’s newsletter, 1919 – 2010 includes session minutes and membership/baptism/marriage/death records, as well as minutes of men’s, women’s, and youth groups, including their mission work in their communities.</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=