nt.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"http://search.proquest.com/americanperiodicals/advanced/\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '5617389',_st_inc_return: this});\">\n                                                                American Periodicals\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Published between 1741 and 1900, these periodicals include special interest and general magazines, literary and professional journals, children and women magazines, and many other historically significant periodicals.</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"http://infoweb.newsbank.com/?db=AOFA\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '5617428',_st_inc_return: this});\">\n                                                                Archive of Americana\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p>Thousands of newspapers, books, ephemera, broadsides, pamphlets, government publications, and more, detailing life in 17th-, 18th-, and 19th-century America. Includes <i>America's Historical Imprints</i>; <i>Early American Newspapers, 1690-1876</i>; <i>America's Historical Newspapers</i>; <i>Caribbean Newspapers, 1718-1876</i>; <i>American State Papers, 1789-1838</i>; and <i>U.S. Congressional Serial Set, 1817-1994</i>.</p></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://infotrac.galegroup.com/itweb/uclosangeles?db=APOA\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '47648495',_st_inc_return: this});\">\n                                                                Associated Press Collections Online (Gale Primary Sources)\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Digitized archives of the Associated Press, including news features, internal communications, U.S. City bureaus, Middle East and European bureaus, and some images.</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://www.cios.org/www/absrch.htm\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '8296023',_st_inc_return: this});\">\n                                                                ComAbstracts\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\">Abstracts of articles published in the primary professional literature of the communication(s) field. Abstracts may be searched by word, phrase, or author. The database is updated at intervals throughout the year with both older and newer materials.</div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"http://www.cios.org/\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_conte