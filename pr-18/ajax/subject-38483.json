lor-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"http://www.library.ucla.edu/service/campus-access\" target=\"_blank\"><img loading=\"lazy\" alt=\"Requires UCLA authentication\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sites/705/icons/983/key-newblue-transp.gif\"/><i class=\"fa fa-fw fa-external-link \" \n    aria-hidden=\"true\"\n           title=\"This link opens in a new window\"\n   ></i><span class=\"sr-only\">This link opens in a new window</span></a> </li></ul></div>\n                                    <span class=\"s-lg-az-result-badge-featured label\">Best Bet</span>\n                                                                            </div>\n            <div class=\"s-lg-gtitle\" >\n                                <a  target=&quot;_blank&quot;  href=\"https://mathscinet.ams.org/mathscinet/publications-search\" onclick=\"return springSpace.springTrack.trackLink({link: this,_st_type_id: '16',_st_content_id: '5618134',_st_inc_return: this});\">\n                                                                MathSciNet\n                                                        </a>\n                                \n            </div>\n            <div class=\"s-lg-az-result-description\"><p>A comprehensive database covering the world's mathematical literature since 1940, providing access to Mathematical Reviews and Current Mathematical Publications.</p></div>\n                    </div>\n    </div>\n</div>\n<div>\n    <div class=\"s-lib-box s-lib-border-round s-lib-box-idx-guide-list\">\n        <div class=\"s-lib-box-content\">\n            <div class=\"s-lg-az-result-badges s-lg-gmeta pull-right s-lg-small s-lib-color-lt-grey\">\n                <div class=\"s-lg-icons pad-left-sm\"><ul class=\"\"><li><a href=\"https://guides.library.ucla.edu/free-resources/home\" target=\"_blank\"><img loading=\"lazy\" alt=\"Open Access\" class=\"s-lg-icon\" src=\"//d2jv02qf7xgjwx.cloudfront.net/sit